# Backend 環境變數範本
# 複製此檔案為 .env 並填入實際值
# 注意：.env 檔案已被 .gitignore 忽略，不會提交到 Git

# 應用程式設定
APP_NAME=Chopsticks ERP MVP
ENV=dev

# 資料庫連線（SQLite 範例）
DATABASE_URL=sqlite:///./app.db

# 如果使用 PostgreSQL（生產環境），請使用以下格式：
# DATABASE_URL=postgresql://user:password@host:port/dbname

# 安全設定
SECRET_KEY=change-me-please-use-a-strong-random-key

# Token 設定
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 設定（多個來源用逗號分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 公開基礎 URL
PUBLIC_BASE_URL=http://localhost:8000

# Print Agent Token（Windows 列印 Agent 使用的 Bearer Token）
# 此 token 用於驗證 Windows 列印 Agent 的身份
PRINT_AGENT_TOKEN=26980288
